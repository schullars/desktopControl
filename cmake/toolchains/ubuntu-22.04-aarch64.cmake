set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(DESKTOPCTL_AARCH64_SYSROOT "" CACHE PATH
    "Ubuntu 22.04 aarch64 sysroot containing the desktop development packages")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES DESKTOPCTL_AARCH64_SYSROOT)
if(NOT DESKTOPCTL_AARCH64_SYSROOT)
    message(FATAL_ERROR
        "Set DESKTOPCTL_AARCH64_SYSROOT to an Ubuntu 22.04 aarch64 sysroot")
endif()
if(NOT EXISTS "${DESKTOPCTL_AARCH64_SYSROOT}/usr/include"
   OR NOT EXISTS "${DESKTOPCTL_AARCH64_SYSROOT}/usr/lib/aarch64-linux-gnu")
    message(FATAL_ERROR
        "DESKTOPCTL_AARCH64_SYSROOT is not a complete Ubuntu aarch64 sysroot")
endif()

set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
set(CMAKE_SYSROOT "${DESKTOPCTL_AARCH64_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${DESKTOPCTL_AARCH64_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(ENV{PKG_CONFIG_SYSROOT_DIR} "${DESKTOPCTL_AARCH64_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR}
    "${DESKTOPCTL_AARCH64_SYSROOT}/usr/lib/aarch64-linux-gnu/pkgconfig:${DESKTOPCTL_AARCH64_SYSROOT}/usr/lib/pkgconfig:${DESKTOPCTL_AARCH64_SYSROOT}/usr/share/pkgconfig")

find_program(DESKTOPCTL_QEMU_AARCH64 qemu-aarch64-static)
if(DESKTOPCTL_QEMU_AARCH64)
    set(CMAKE_CROSSCOMPILING_EMULATOR
        "${DESKTOPCTL_QEMU_AARCH64};-L;${DESKTOPCTL_AARCH64_SYSROOT}"
        CACHE STRING "AArch64 emulator used by CTest" FORCE)
endif()
